{
  "name": "system-8-interactive-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:assets": "node scripts/build-fonts.mjs",
    "build:og": "node scripts/generate-social-preview.mjs",
    "build": "npm run build:assets && npm run build:og && vite build",
    "preview": "vite preview",
    "og:dev": "chokidar \"og-config.json\" \"assets/*.svg\" \"assets/*.ttf\" -c \"npm run build:og\"",
    "test": "vitest run",
    "pretest": "npm run build:og"
  },
  "dependencies": {
    "html2canvas": ">=1.4.1 <2",
    "react": ">=19.2.8 <20",
    "react-dom": ">=19.2.8 <20",
    "sharp": ">=0.35.3 <0.37"
  },
  "devDependencies": {
    "@types/node": ">=22.20.1 <23",
    "@vitejs/plugin-react": ">=5.2.0 <6",
    "autoprefixer": ">=10.5.4 <11",
    "chokidar-cli": ">=3.0.0 <4",
    "node-html-parser": ">=7.1.0 <8",
    "postcss": ">=8.5.25 <9",
    "tailwindcss": ">=3.4.19 <4",
    "toml": ">=3.0.0 <4",
    "typescript": ">=5.8.3 <6",
    "vite": ">=6.4.3 <7",
    "vitest": ">=4.1.10 <5"
  }
}
